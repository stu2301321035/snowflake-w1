USE SCHEMA stages;

CREATE ECOMERSE_DB.STAGES.ECOMERSE_DOCUMENTS;

LIST @ECOMERSE_DB.STAGES.ECOMERSE_DOCUMENTS;

CREATE TABLE td_ecomerse_orders
AS
SELECT  
    $1 as order_id,
    $2 as customer_id, 
    $3 customer_name,
    $4 as order_date,
    $5 as product,
    $6 as quantity, 
    $7 as price,
    $8 as discount,
    $9 as total_amount, 
    $10 as payment_method,
    $11 as shipping_address1, 
    $12 as shipping_address2, 
    $13 as status FROM @ECOMERSE_DB.STAGES.ECOMERSE_DOCUMENTS/ecommerce_orders.csv
WHERE 1=2

